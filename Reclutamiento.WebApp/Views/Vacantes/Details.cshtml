@model ReclutamientoFrontend.WebApp.Models.Dtos.VacanteDto

@{
    ViewData["Title"] = "Detalles de la Vacante";
}

<!-- Google Fonts y Font Awesome -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    :root {
        --navy: #0b1f3a;
        --blue-mid: #1c3d6e;
        --cream: #f5f5f0;
        --beige: #e2d8c3;
        --olive: #6b7c4f;
        --muted: #9aa3b2;
        --danger: #dc3545;
    }

    body {
        background-color: var(--navy);
        font-family: 'Poppins', sans-serif;
        color: var(--cream);
    }

    .container {
        padding-top: 1.5rem;
        padding-bottom: 2rem;
    }

    .card {
        border-radius: 14px;
        background-color: var(--beige);
        box-shadow: 0 14px 38px rgba(2,10,20,0.35);
        border: none;
    }

    .card-header {
        background: linear-gradient(90deg, var(--blue-mid), #153255);
        color: var(--cream);
        padding: 1rem 1.25rem;
    }

        .card-header h4 {
            margin: 0;
            font-weight: 700;
            display: flex;
            gap: .6rem;
            align-items: center;
        }

    .card-body {
        padding: 1.25rem 1.5rem;
        color: var(--cream);
    }

    h5.card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--blue-mid);
        margin-bottom: 1rem;
    }

    dl dt {
        color: #6b7c4f;
        font-weight: 600;
    }

    dl dd {
        color: var(--blue-mid);
        font-weight: 700;
        margin-bottom: .75rem;
    }

    .badge-activa {
        background-color: var(--olive);
        color: var(--cream);
        font-weight: 700;
        padding: .45rem .75rem;
        border-radius: 8px;
    }

    .badge-inactiva {
        background-color: rgba(28,61,110,0.12);
        color: var(--blue-mid);
        font-weight: 700;
        padding: .45rem .75rem;
        border-radius: 8px;
    }

    .sub-card {
        background-color: var(--cream);
        border-radius: 10px;
        padding: 1rem;
        box-shadow: 0 6px 16px rgba(2,10,20,0.18);
        color: var(--blue-mid);
    }

    .btn {
        border-radius: 10px;
        font-weight: 600;
        padding: .55rem .9rem;
        transition: transform .12s ease, box-shadow .12s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .btn-warning {
        background: linear-gradient(90deg, #d4a11a, #c48e16);
        border: none;
        color: #0b1f3a;
    }

    .btn-info {
        background-color: var(--blue-mid);
        border: none;
        color: var(--cream);
    }

    .btn-secondary {
        background-color: rgba(245,245,240,0.12);
        color: var(--olive);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .border-top {
        border-top: 1px solid rgba(255,255,255,0.04);
        padding-top: 1rem;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-sm-12">
            <div class="card shadow-lg border-0">
                <div class="card-header">
                    <h4 class="mb-0"><i class="fa-solid fa-file-invoice me-2"></i> Detalles de la Vacante</h4>
                </div>
                <div class="card-body p-4">

                    <h5 class="card-title mb-4 border-bottom pb-2">@Model.Titulo</h5>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Ubicación</dt>
                        <dd class="col-sm-8">@Model.Ubicacion</dd>

                        <dt class="col-sm-4">Estado Actual</dt>
                        <dd class="col-sm-8">
                            @if (Model.EstaActiva)
                            {
                                <span class="badge-activa">Activa</span>
                            }
                            else
                            {
                                <span class="badge-inactiva">Inactiva</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Fecha de Creación</dt>
                        <dd class="col-sm-8">@Model.FechaCreacion.ToShortDateString()</dd>
                    </dl>

                    <h5 class="card-title mb-3 border-bottom pb-2">Descripción del Puesto</h5>
                    <div class="sub-card mb-4">
                        <p class="card-text">@Html.Raw(Model.Descripcion?.Replace("\n", "<br/>"))</p>
                    </div>

                    <h5 class="card-title mb-3 border-bottom pb-2">Requisitos y Perfil</h5>
                    <div class="sub-card mb-4">
                        <p class="card-text">@Html.Raw(Model.Requisitos?.Replace("\n", "<br/>"))</p>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning order-2 order-md-1">
                            <i class="fa-solid fa-edit me-2"></i> Editar
                        </a>
                        <a asp-action="Solicitudes" asp-route-vacanteId="@Model.Id" class="btn btn-info order-3 order-md-2">
                            <i class="fa-solid fa-users me-2"></i> Ver Solicitudes
                        </a>
                        <a asp-action="Index" class="btn btn-secondary order-1 order-md-3">
                            <i class="fa-solid fa-arrow-left me-2"></i> Regresar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
