@model IEnumerable<ReclutamientoFrontend.WebApp.Models.Dtos.VacanteDto>
@using System.Text.Json
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Inicio";
    var userRole = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
    var userName = User?.Identity?.Name ?? "";
    var rawRol = "";
    if (Context.Session != null && Context.Session.Keys.Contains("RawRol"))
    {
        rawRol = Context.Session.GetString("RawRol") ?? "";
    }
    var vacantesAplicadasIds = (ViewBag.VacantesAplicadasIds as List<int>) ?? new List<int>();
}

<!-- Google Fonts y Font Awesome -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<!-- Estilos embebidos con paleta personalizada -->
<style>
    body {
        background-color: #0b1f3a;
        font-family: 'Poppins', sans-serif;
        color: #f5f5f0;
    }

    .display-4 {
        font-weight: 600;
        color: #f5f5f0;
    }

    .lead {
        color: #e2d8c3;
    }

    .card {
        background-color: #e2d8c3;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.8);
        }

    .card-header {
        background-color: #1c3d6e;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        padding: 1rem;
        color: #f5f5f0;
    }

    .card-title {
        font-weight: 600;
        font-size: 1.2rem;
    }

    .card-body {
        color: #1c3d6e;
        padding: 1rem;
    }

    .card-footer {
        background-color: #f5f5f0;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 16px;
        padding: 0.75rem 1rem;
    }

    .btn {
        border-radius: 10px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #1c3d6e;
        border: none;
        color: #f5f5f0;
    }

        .btn-primary:hover {
            background-color: #16345c;
            transform: scale(1.03);
        }

    .btn-success {
        background-color: #6b7c4f;
        border: none;
        color: #f5f5f0;
    }

        .btn-success:hover {
            background-color: #5a6a42;
            transform: scale(1.03);
        }

    .alert {
        border-radius: 10px;
        font-size: 0.95rem;
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #842029;
    }

    hr {
        border-top: 1px solid #ccc;
    }
</style>

<div class="container py-5">
    <div class="mb-3">
        <span class="text-secondary">
            @if (!string.IsNullOrEmpty(rawRol))
            {
                // Mantener o eliminar si no es relevante para el solicitante
            }
        </span>
    </div>

    @if (userRole == "Admin")
    {
        <div class="text-center mt-5">
            <h1 class="display-4 mb-4">
                <i class="fa-solid fa-hand-sparkles"></i> Bienvenid@s a EteriumTech
            </h1>
            <p class="lead">Panel de administración para gestionar oportunidades laborales.</p>
            <a asp-controller="Vacantes" asp-action="Index" class="btn btn-primary btn-lg mt-3">
                <i class="fa-solid fa-gears me-2"></i> Gestionar Vacantes
            </a>
        </div>
    }
    else if (userRole == "Solicitante" || userRole == "Guest")
    {
        <div class="text-center mb-5">
            <h1 class="display-4">
                <i class="fa-solid fa-briefcase"></i> Encuentra Tu Próxima Oportunidad
            </h1>
            <p class="lead">Explora las vacantes disponibles y únete a nuestro equipo de innovación.</p>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                <i class="fa-solid fa-circle-info"></i> No hay vacantes disponibles en este momento.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var vacante in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="fa-solid fa-briefcase me-2"></i> @vacante.Titulo
                                </h5>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="card-text flex-grow-1">
                                    @(vacante.Descripcion?.Length > 500 ? vacante.Descripcion.Substring(0, 500) + "..." : vacante.Descripcion)
                                </p>
                                <div class="mb-3">
                                    <strong><i class="fa-solid fa-location-dot me-1"></i> Ubicación:</strong> @vacante.Ubicacion
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-between align-items-center">
                                <a asp-controller="Solicitudes" asp-action="Create" asp-route-vacanteId="@vacante.Id" class="btn btn-success btn-sm">
                                    <i class="fa-solid fa-paper-plane me-1"></i> Aplicar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#detalleVacanteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var titulo = button.data('titulo');
                var descripcion = button.data('descripcion');
                var ubicacion = button.data('ubicacion');
                var requisitos = button.data('requisitos');

                var modal = $(this);
                modal.find('#modalVacanteTitulo').text(titulo);
                modal.find('#modalVacanteDescripcion').text(descripcion);
                modal.find('#modalVacanteUbicacion').text(ubicacion);
                modal.find('#modalVacanteRequisitos').text(requisitos);
            });
        });
    </script>
}
