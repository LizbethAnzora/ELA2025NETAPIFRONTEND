@using ReclutamientoFrontend.WebApp.Models.Dtos
@model UsuarioDto

@{
    ViewData["Title"] = "Crear Nuevo Administrador";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    :root {
        --navy: #0b1f3a;
        --blue-mid: #1c3d6e;
        --cream: #f5f5f0;
        --beige: #e2d8c3;
        --olive: #6b7c4f;
        --muted: #9aa3b2;
        --danger: #dc3545;
    }

    body {
        background-color: var(--navy);
        font-family: 'Poppins', sans-serif;
        color: var(--cream);
    }

    .container {
        padding-top: 1.75rem;
        padding-bottom: 2.5rem;
    }

    .card {
        border-radius: 14px;
        background-color: var(--beige);
        box-shadow: 0 18px 40px rgba(2,10,20,0.35);
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(90deg, var(--olive), #55704a);
        color: var(--cream);
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(0,0,0,0.04);
    }

    .form-control {
        border-radius: 10px;
        background-color: var(--cream);
        color: var(--blue-mid);
        border: 1px solid rgba(28,61,110,0.12);
        padding: 0.6rem 0.75rem;
    }

    .btn-success {
        background-color: var(--olive);
        border: none;
        color: var(--cream);
    }

    .btn-secondary {
        background-color: rgba(245,245,240,0.12);
        color: var(--olive);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #842029;
        border-radius: 10px;
    }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-12">
            <div class="card shadow-lg border-0">
                <div class="card-header">
                    <h4 class="mb-0"><i class="fa-solid fa-user-plus me-2"></i> Registrar Administrador</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post" autocomplete="off" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i> Por favor, corrige los errores antes de guardar.
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label">Nombre Completo <span class="text-danger">*</span></label>
                            <input asp-for="NombreCompleto" class="form-control" placeholder="Ingresa el nombre completo" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CorreoElectronico" class="form-label">Correo Electrónico <span class="text-danger">*</span></label>
                            <input asp-for="CorreoElectronico" type="email" class="form-control" placeholder="correo@ejemplo.com" />
                            <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Contrasena" class="form-label">Contraseña <span class="text-danger">*</span></label>
                            <input asp-for="Contrasena" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-info small py-2" role="alert" style="background-color: rgba(226,216,195,0.12); color: var(--navy); border:1px solid rgba(255,255,255,0.04);">
                            <i class="fa-solid fa-info-circle me-2"></i> Los campos marcados con <span class="text-danger">*</span> son obligatorios.
                        </div>

                        <div class="d-flex flex-column flex-md-row justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary order-2 order-md-1">
                                <i class="fa-solid fa-circle-xmark me-2"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success order-1 order-md-2">
                                <i class="fa-solid fa-save me-2"></i> Guardar Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
