@using ReclutamientoFrontend.WebApp.Models.ViewModels
@model EditarUsuarioViewModel

@{
    ViewData["Title"] = "Editar Nombre de Administrador";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    :root {
        --navy: #0b1f3a;
        --blue-mid: #1c3d6e;
        --cream: #f5f5f0;
        --beige: #e2d8c3;
        --olive: #6b7c4f;
        --muted: #9aa3b2;
    }

    body {
        background-color: var(--navy);
        font-family: 'Poppins',sans-serif;
        color: var(--cream);
    }

    .container {
        padding-top: 1.5rem;
        padding-bottom: 2rem;
    }

    .card {
        border-radius: 14px;
        background-color: var(--beige);
        box-shadow: 0 18px 40px rgba(2,10,20,0.35);
    }

    .card-header {
        background: linear-gradient(90deg,var(--olive),#55704a);
        color: var(--cream);
        padding: 1rem 1.25rem;
    }

    .card-body {
        padding: 1.25rem 1.5rem;
        color: var(--olive);
    }

    .form-control {
        border-radius: 10px;
        background-color: var(--cream);
        color: var(--blue-mid);
        border: 1px solid rgba(28,61,110,0.12);
        padding: .6rem .75rem;
    }

    .form-control-plaintext {
        background: transparent;
        border: none;
        padding: .5rem 0;
        color: var(--olive);
        font-weight: 700;
    }

    .btn-warning {
        background: linear-gradient(90deg,#d4a11a,#c48e16);
        border: none;
        color: #0b1f3a;
    }

    .btn-secondary {
        background-color: rgba(245,245,240,0.12);
        color: var(--olive);
        border: 1px solid rgba(255,255,255,0.04);
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-12">
            <div class="card shadow-lg border-0">
                <div class="card-header">
                    <h4 class="mb-0"><i class="fa-solid fa-user-pen me-2"></i> Editar Nombre</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Editar" method="post" autocomplete="off" novalidate>
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i> Por favor, corrige los errores antes de guardar.
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Correo Electrónico Actual</label>
                            <p class="form-control-plaintext fw-bold text-primary border-bottom pb-2">@ViewBag.CorreoActual</p>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NombreCompleto" class="form-label fw-bold">Nuevo Nombre Completo <span class="text-danger">*</span></label>
                            <input asp-for="NombreCompleto" class="form-control" placeholder="Ingrese el nuevo nombre completo" maxlength="100" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-column flex-md-row justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary order-2 order-md-1">
                                <i class="fa-solid fa-circle-xmark me-2"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning order-1 order-md-2">
                                <i class="fa-solid fa-save me-2"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
