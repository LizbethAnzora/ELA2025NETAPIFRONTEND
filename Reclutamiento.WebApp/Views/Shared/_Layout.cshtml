@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var userRole = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EteriumTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />

    <!-- Estilos embebidos con fondo empresarial -->
    <style>
        body {
            background-image: url('/images/imagen empresarial.jpg'); /* Ruta relativa o CDN */
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            font-family: 'Poppins', sans-serif;
            color: #f5f5f0;
        }

        .navbar {
            background-color: rgba(28, 61, 110, 0.95);
            border-bottom: 1px solid #16345c;
            transition: box-shadow 0.3s ease;
        }

            .navbar:hover {
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.4);
            }

        .badge {
            font-size: 0.85rem;
            padding: 0.4em 0.6em;
            border-radius: 6px;
            background-color: #6b7c4f;
            color: #f5f5f0;
        }

        .btn-outline-danger {
            border-radius: 8px;
            border-color: #dc3545;
            color: #dc3545;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

            .btn-outline-danger:hover {
                background-color: #dc3545;
                color: #fff;
                transform: scale(1.03);
            }

        #wrapper {
            min-height: 100vh;
            background-color: rgba(11, 31, 58, 0.85); /* Azul marino semitransparente */
        }

        main.container {
            animation: fadeIn 0.5s ease-in-out;
        }

        .text-secondary {
            color: #e2d8c3 !important;
        }

        
    </style>
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <partial name="_Sidebar" model="userRole" />
        <!-- /#sidebar-wrapper -->
        <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1">
            <nav class="navbar navbar-expand-lg shadow-sm">
                <div class="container-fluid">
                    <div class="d-flex w-100 justify-content-end align-items-center gap-3">
                        @if (isAuthenticated)
                        {
                            var rawRol = "";
                            try
                            {
                                rawRol = Context.Session.GetString("RawRol") ?? "";
                            }
                            catch { }
                            <span class="me-2 text-secondary">
                                <i class="fa-solid fa-user"></i> @(User?.Identity?.Name ?? "")
                                <span class="badge ms-2">@userRole</span>
                            </span>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </nav>

            <main class="container mt-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
